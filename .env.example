# ---------- Shopify ----------
# Dev Dashboard 后台 Public App「Tablely」的 client_id / client secret
SHOPIFY_API_KEY=<client_id>
SHOPIFY_API_SECRET=<client_secret>
# 读商品与变体 + 写 app-owned metafield；Function 折扣（§2.2）
SCOPES=read_products,write_products,write_discounts,write_cart_transforms
# 生产地址（本地 dev 时 CLI 会自动注入 tunnel 地址）
SHOPIFY_APP_URL=https://tablely.zhenjunit.com
# 可选：店铺自定义域，用于 auth 校验
# SHOP_CUSTOM_DOMAIN=

# ---------- 数据库 ----------
# 本地开发（brew PostgreSQL 16）：postgresql://tablely:<密码>@localhost:5432/tablely?schema=public
# 生产（compose 内网服务名 postgres，不映射宿主机端口）：
# postgresql://tablely:<同一个密码>@postgres:5432/tablely?schema=public&connection_limit=10
DATABASE_URL=postgresql://tablely:tablely@localhost:5432/tablely?schema=public

# 仅生产 compose 用：postgres 容器的初始密码（纯字母数字，避免 URL 转义问题）
POSTGRES_PASSWORD=<随机 32 字节 hex>

# ---------- 运行时 ----------
NODE_ENV=development
PORT=3000
# `/healthz` 返回的版本号（未注入时为 0.0.0-dev）；生产镜像构建时注入
APP_VERSION=0.0.0-dev

# ---------- Billing（M9）----------
# true = appSubscriptionCreate 带 test:true（开发店不真实扣费）；生产置 false
BILLING_TEST=true