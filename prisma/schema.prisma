// Tablely — 批发订购表应用（Wholesale order tables）
// 数据库：自建 PostgreSQL 16（本地开发用 brew postgresql@16，生产用 Docker 容器）
// learn more: https://pris.ly/d/prisma-schema
//
// ⚠️ 所有时间列必须显式声明 @db.Timestamptz(3)（沿用 Cartly / Attributly / Linkly 的踩坑结论）：
// 默认映射会生成 `timestamp without time zone`，此时 Prisma 绑定的 Date 参数
// 会被 Postgres 当作 timestamptz 隐式转换，转换结果取决于数据库会话时区
// （本地 Asia/Shanghai 会让范围查询整体偏移 8 小时）；
// 且 `AT TIME ZONE` 在 timestamp 列上语义相反，跨时区分天会分错桶。
//
// M1 只建「脚手架必需」两表：会话存储 + webhook 幂等去重（Y8）。
// M2 一次性补全 §四 的全部业务模型（ShopSettings / ProductTable / VariantRule /
// CustomerGroup / LayoutTemplate / Quote / MixMatch* / Wholesale* / AddToCartEvent /
// PlanState / DiscountState）。
//
// ⚠️ 金额一律用 Decimal（禁止浮点，避免 0.1+0.2 误差污染定价）：阶梯价 / 批发价 /
// 起订金额均为 @db.Decimal(10, 2)。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ⓪ 会话存储（@shopify/shopify-app-session-storage-prisma 依赖）
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime? @db.Timestamptz(3)
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime? @db.Timestamptz(3)
}

// ① webhook 幂等去重（Y8，§8.2 C）
// 以 Shopify 投递头 `X-Shopify-Webhook-Id` 为主键：同一投递重复到达时
// create 触发唯一键冲突（P2002），据此判定「已处理过」，不重复执行。
// 尤其 `shop/redact` 必须幂等（§8.1），卸载重放时不能报错。
model WebhookEvent {
  id         String   @id // X-Shopify-Webhook-Id
  topic      String // 归一化后的大写主题名（如 SHOP_REDACT）
  shop       String
  receivedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([receivedAt]) // 定时清理超期行（§8.1 数据保留）
}

/* ================================================================== *
 * ① 店铺级设置（§四）
 * 一份店铺一行；`createdAt` 即 installedAt（Y1 激活漏斗第 0 步）。
 * `tablely.settings` metafield 的内容由本表序列化而来（§2.7 契约 v2）。
 * ================================================================== */
model ShopSettings {
  id             String   @id @default(cuid())
  shop           String   @unique
  enabled        Boolean  @default(false) // 全局开关
  defaultLayout  String   @default("table") // table | grid | list | matrix
  columns        Json     @default("{}") // 列开关默认值（image / sku / id / price / stock）
  taxDisplay     String   @default("incl") // incl | excl（对应图 "Price w/o VAT"）
  outOfStockMode String   @default("gray") // gray | hide | backorder
  gateMode       String   @default("off") // off | hide_price | hide_table
  gateTags       String[] @default([]) // 批发客户标签
  tierModel      String   @default("percent") // 阶梯价模型 A/B：percent | fixed（§2.2）
  tierEnabled    Boolean  @default(true) // 阶梯价总开关（§2.2）
  theme          Json     @default("{}") // 品牌色 / 圆角 / 密度
  feedbackStyle  String   @default("inline") // inline | toast | both
  hideNative     Boolean  @default(false) // B1：隐藏主题自带加购区（默认关闭）
  nativeSelector String? // B1：自定义选择器，null = 用内置候选
  blockAddedAt   DateTime? @db.Timestamptz(3) // Y1 激活漏斗：App Block 已添加到主题
  firstProductAt DateTime? @db.Timestamptz(3) // Y1 激活漏斗：首个订购表启用
  firstAddToCart DateTime? @db.Timestamptz(3) // Y1 激活漏斗：首次店面加购成功
  orderMinAmount Decimal? @db.Decimal(10, 2) // Y14：店铺级默认整单起订金额（null = 不限，商品可覆写）
  createdAt      DateTime @default(now()) @db.Timestamptz(3) // 即 installedAt（Y1 激活漏斗第 0 步）
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
}

/* ================================================================== *
 * ② 商品级订购表设置（§四）
 * ================================================================== */
model ProductTable {
  id             String   @id @default(cuid())
  shop           String
  productId      String
  enabled        Boolean  @default(true)
  layout         String? // 覆写全局布局
  columns        Json     @default("{}") // 列开关
  defaultTiers   Json     @default("[]") // B6：商品级默认档位表，变体未覆写时继承
  orderMinAmount Decimal? @db.Decimal(10, 2) // Y14：整单起订金额（null = 不限，继承 ShopSettings 默认）
  sortOrder      Int      @default(0)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@unique([shop, productId])
}

/* ================================================================== *
 * ③ 变体级数量规则与档位（§四）
 * ================================================================== */
model VariantRule {
  id        String @id @default(cuid())
  shop      String
  variantId String
  productId String
  min       Int    @default(1)
  max       Int?
  step      Int    @default(1) // 包装倍数
  tiers     Json   @default("[]") // [{qty:5, price:"117.00"}] 或 [{qty:5, percent:10}]

  @@unique([shop, variantId])
  @@index([shop, productId])
}

/* ================================================================== *
 * ④ 客户组（B11）—— 一组映射到一个 Shopify 客户标签
 * ================================================================== */
model CustomerGroup {
  id        String   @id @default(cuid())
  shop      String
  name      String // 显示名，如「一级代理」
  tag       String // 映射的 Shopify 客户标签，如 tier1
  note      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([shop, tag])
  @@index([shop])
}

/* ================================================================== *
 * ⑤ 布局模板（B12）—— 命名模板集，按范围套用
 * ================================================================== */
model LayoutTemplate {
  id        String   @id @default(cuid())
  shop      String
  name      String
  payload   Json     @default("{}") // 布局 / 列开关 / 样式快照 / 变体规则与商品级起订金额（§16.6；仅在勾选「一并覆写规则」时写入生效）
  isDefault Boolean  @default(false) // 全局默认模板（新商品继承）
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([shop, name])
  @@index([shop])
}

/* ================================================================== *
 * ⑥ 报价单（Y17）—— 价格快照 + 匿名 token / 客户专属两模式
 * ================================================================== */
model Quote {
  id         String   @id @default(cuid())
  shop       String
  token      String   @unique // 32 字节随机 base64url，可撤销/重生成
  title      String?
  note       String? // 商家备注与条款（输出时 escape）
  currency   String
  validUntil DateTime @db.Timestamptz(3)
  customerId String? // ② 专属报价的归属客户；redact 时置 null 并保留
  lines      Json     @default("[]") // [{variantId, sku, title, qty, unitPrice, tiers}]
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([shop, createdAt])
}

/* ================================================================== *
 * ⑦ Mix & Match 混单（Y13）—— 组内合计达量享折扣
 * ================================================================== */
model MixMatchGroup {
  id        String   @id @default(cuid())
  shop      String
  name      String
  tiers     Json     @default("[]") // [{qty:5, percent:10}] 或 [{qty:5, price:"99.00"}]
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([shop, name])
  @@index([shop])
}

/* ⑧ 混单组成员（显式加入组的变体） */
model MixMatchMember {
  id        String @id @default(cuid())
  shop      String
  groupId   String
  variantId String
  productId String

  @@unique([shop, groupId, variantId])
  @@index([shop, variantId])
}

/* ================================================================== *
 * ⑨ 批发价（B5）—— 按「客户组（标签）」分级，一个变体可有多组不同价
 * 多标签命中取最低价（§16.4）。
 * ================================================================== */
model WholesalePrice {
  id        String   @id @default(cuid())
  shop      String
  variantId String
  groupTag  String // 客户标签，如 tier1 / tier2
  price     Decimal  @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([shop, variantId, groupTag])
  @@index([shop, groupTag])
}

/* ================================================================== *
 * ⑩ 分销商申请（§四 / §15.1）
 * ================================================================== */
model WholesaleApplication {
  id         String   @id @default(cuid())
  shop       String
  email      String
  customerId String?
  payload    Json // 表单字段（姓名/公司/网站/渠道…）
  status     String   @default("pending") // pending | approved | rejected
  note       String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([shop, status])
}

/* ================================================================== *
 * ⑪ 加购统计（A3）—— 只记加购，不引入 Web Pixel（§八）
 * `customerId` 仅在已登录时记（A4：历史加购再下单）；未登录为 null。
 * ================================================================== */
model AddToCartEvent {
  id         String   @id @default(cuid())
  shop       String
  variantId  String
  productId  String
  quantity   Int
  rows       Int      @default(1) // 本次提交的行数
  source     String   @default("table") // table | reorder | csv
  customerId String? // A4：已登录客户才记，供「历史加购再下单」；未登录为 null
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([shop, createdAt])
  @@index([shop, customerId, createdAt]) // A4：按客户查历史加购
}

/* ================================================================== *
 * ⑫ 套餐状态（M9 Billing 回写）
 * 沿用 Attributly 的字段口径：plan / trialEndsAt / syncedAt。
 * ================================================================== */
model PlanState {
  id          String    @id @default(cuid())
  shop        String    @unique
  plan        String    @default("free") // free | pro
  trialEndsAt DateTime? @db.Timestamptz(3)
  syncedAt    DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
}

/* ================================================================== *
 * ⑬ 自动折扣的生命周期状态（A2，§2.2.2）
 * 每店共 3 个 automatic discount（阶梯价 / 批发价 / 混单），
 * 降级时置 `active = false`（不删除），恢复 Pro 后置回 active 且不重复创建。
 * ================================================================== */
model DiscountState {
  id                 String    @id @default(cuid())
  shop               String    @unique
  tierDiscountId     String? // 阶梯价 automatic discount 的 GID
  wholeDiscountId    String? // 批发价 automatic discount 的 GID
  mixMatchDiscountId String? // Y13：Mix & Match automatic discount 的 GID（§2.2.2 每店共 3 个）
  active             Boolean   @default(false) // 降级 → false（3 个折扣全置 inactive，不删除）
  syncedAt           DateTime? @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)
}